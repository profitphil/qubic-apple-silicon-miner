+{
+    unsigned __int128 p = (unsigned __int128)a * b;
+    if (hi) *hi = (unsigned long long)(p >> 64);
+    return (unsigned long long)p;
+}
+static inline unsigned long long __shiftleft128(unsigned long long lo, unsigned long long hi, unsigned char shift)
+{
+    return (unsigned long long)((((unsigned __int128)hi << 64 | lo) << (shift & 63)) >> 64);
+}
+static inline unsigned long long __shiftright128(unsigned long long lo, unsigned long long hi, unsigned char shift)
+{
+    return (unsigned long long)(((unsigned __int128)hi << 64 | lo) >> (shift & 63));
